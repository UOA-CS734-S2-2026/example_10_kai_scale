rules_version = '2';

// COMPSCI 734 - Firestore security rules.
//
// Until now this file said "anyone may read ANY document". That was fine when
// the only collections were events and users. Then we added `organisers`,
// which names every person allowed to post, and the old rule quietly made that
// list public to anyone holding the project id. Nothing in the rules changed.
// The SYSTEM changed around them. Security breaks when systems change.
//
// So: say exactly what is public, and let everything else fall through to the
// default, which is DENY.
//
// Remember who these rules apply to. The Flutter app's map listener, and
// anybody with curl, talk to Firestore directly and are checked here. Our
// server uses the Admin SDK, which bypasses rules entirely, so every write it
// makes (after checking the token, the organiser and the owner) still works.

service cloud.firestore {
  match /databases/{database}/documents {

    // The feed is public: that is the point of Kai Finder. Phones read this
    // collection directly for live map updates.
    match /events/{eventId} {
      allow read: if true;
      allow write: if false; // every write goes through the server
    }

    // Nothing else is matched, so nothing else is readable or writable from
    // a client. That includes `organisers`, the old `users`, and any
    // collection someone adds next month. Deny by default is what makes the
    // NEXT change safe too.
  }
}
